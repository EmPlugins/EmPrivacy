    read?: AccessConstraints;
  };
  media?: {
    read?: AccessConstraints;
    write?: AccessConstraints;
  };
  network?: {
    request?: {
      allowedHosts?: string[];
    };
  };
  email?: {
    send?: AccessConstraints;
    events?: AccessConstraints;
    transport?: AccessConstraints;
  };
