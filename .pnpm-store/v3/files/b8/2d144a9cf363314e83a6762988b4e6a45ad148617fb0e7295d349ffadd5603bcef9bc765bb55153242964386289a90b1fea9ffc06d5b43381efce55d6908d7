{"version":3,"file":"PluginRegistry.mjs","names":[],"sources":["../../../src/astro/routes/PluginRegistry.tsx"],"sourcesContent":["/**\n * Admin Wrapper\n *\n * Imports plugin admin modules from the virtual module and passes them\n * to AdminApp via props. This ensures plugin components are bundled\n * together with the admin app and available via React context.\n */\n\nimport { AdminApp, type AdminBranding } from \"@emdash-cms/admin\";\nimport type { Messages } from \"@lingui/core\";\n// @ts-ignore - virtual module generated by integration\nimport { pluginAdmins } from \"virtual:emdash/admin-registry\";\n// @ts-ignore - virtual module generated by integration\nimport { authProviders } from \"virtual:emdash/auth-providers\";\n\ninterface AdminWrapperProps {\n\tlocale: string;\n\tmessages: Messages;\n\t/** Configured admin white-label branding (logo, site name), read server-side from `admin.astro`. */\n\tadminBranding?: AdminBranding;\n}\n\nexport default function AdminWrapper({ locale, messages, adminBranding }: AdminWrapperProps) {\n\treturn (\n\t\t<AdminApp\n\t\t\tpluginAdmins={pluginAdmins}\n\t\t\tauthProviders={authProviders}\n\t\t\tadminBranding={adminBranding}\n\t\t\tlocale={locale}\n\t\t\tmessages={messages}\n\t\t/>\n\t);\n}\n"],"mappings":";;;;;;;;;;;;;AAsBA,SAAwB,aAAa,EAAE,QAAQ,UAAU,iBAAoC;AAC5F,QACC,oBAAC;EACc;EACC;EACA;EACP;EACE;GACT"}