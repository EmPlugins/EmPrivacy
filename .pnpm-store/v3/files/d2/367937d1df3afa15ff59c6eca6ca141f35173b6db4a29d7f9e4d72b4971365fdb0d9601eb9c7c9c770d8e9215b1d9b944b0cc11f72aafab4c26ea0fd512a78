{
  "name": "@emdash-cms/registry-client",
  "version": "0.6.0",
  "description": "Atproto-aware client for the EmDash plugin registry: credential storage, publisher repo operations, and discovery against an aggregator.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./credentials": {
      "types": "./dist/credentials/index.d.ts",
      "default": "./dist/credentials/index.js"
    },
    "./publishing": {
      "types": "./dist/publishing/index.d.ts",
      "default": "./dist/publishing/index.js"
    },
    "./release-service": {
      "types": "./dist/release-service/index.d.ts",
      "default": "./dist/release-service/index.js"
    },
    "./internal/conformance": {
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "default": "./dist/discovery/index.js"
    },
    "./direct-pds": {
      "types": "./dist/direct-pds/index.d.ts",
      "default": "./dist/direct-pds/index.js"
    },
    "./env": {
      "types": "./dist/env/index.d.ts",
      "default": "./dist/env/index.js"
    },
    "./listing-policy": {
      "types": "./dist/listing-policy.d.ts",
      "default": "./dist/listing-policy.js"
    },
    "./withdrawal": {
      "types": "./dist/withdrawal.d.ts",
      "default": "./dist/withdrawal.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@atcute/atproto": "^4.0.2",
    "@atcute/client": "^5.0.0",
    "@atcute/crypto": "^2.4.1",
    "@atcute/identity": "^2.0.0",
    "@atcute/identity-resolver": "^2.0.0",
    "@atcute/lexicons": "^2.0.0",
    "@atcute/multibase": "^1.2.0",
    "@atcute/repo": "^1.0.0",
    "@emdash-cms/registry-lexicons": "0.5.0",
    "@emdash-cms/registry-moderation": "0.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "24.10.13",
    "@types/semver": "^7.5.8",
    "publint": "0.3.17",
    "semver": "^7.6.3",
    "tsdown": "0.20.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "@emdash-cms/atproto-test-utils": "0.0.0"
  },
  "keywords": [
    "emdash",
    "cms",
    "plugin-registry",
    "atproto",
    "fair"
  ],
  "author": "Matt Kane",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emdash-cms/emdash.git",
    "directory": "packages/registry-client"
  },
  "homepage": "https://github.com/emdash-cms/emdash",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "check": "publint && attw --pack --ignore-rules=cjs-resolves-to-esm --ignore-rules=no-resolution"
  }
}