{
  "name": "@atcute/atproto",
  "version": "4.0.3",
  "description": "AT Protocol (com.atproto.*) schema definitions",
  "keywords": [
    "atcute",
    "atproto"
  ],
  "license": "0BSD",
  "repository": {
    "url": "https://github.com/mary-ext/atcute",
    "directory": "packages/definitions/atproto"
  },
  "files": [
    "dist/",
    "!dist/**/*.{test,bench}.*"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./types/*": "./dist/lexicons/types/com/atproto/*.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@atcute/lexicons": "^2.0.2"
  },
  "devDependencies": {
    "@atcute/atproto": "file:",
    "@atcute/lex-cli": "^3.2.1"
  },
  "peerDependencies": {
    "@atcute/lexicons": "^2.0.0"
  },
  "atcute:lexicons": {
    "mappings": {
      "com.atproto.*": {
        "type": "namespace",
        "path": "./types/{{nsid_remainder}}"
      }
    }
  },
  "scripts": {
    "build": "tsgo",
    "pull": "lex-cli pull",
    "generate": "lex-cli generate",
    "prepublish": "rm -rf dist; pnpm run build"
  }
}