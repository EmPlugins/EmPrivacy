{
  "//": "SPDX-License-Identifier: MIT",
  "name": "@emplugins/emprivacy",
  "version": "1.0.0",
  "description": "Cookie consent and privacy notices for EmDash (GDPR, CCPA/CIPA-oriented configuration)",
  "type": "module",
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./sandbox": "./dist/sandbox-entry.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/DEVELOPMENT.md",
    "docs/GETTING_STARTED.md",
    "docs/PLUGIN_SETTINGS.md",
    "docs/RELEASE_NOTES.md",
    "docs/RELEASES.md",
    "docs/TESTING.md"
  ],
  "keywords": [
    "emdash",
    "cms",
    "plugin",
    "privacy",
    "cookie",
    "consent",
    "gdpr",
    "ccpa",
    "cmp"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "peerDependencies": {
    "emdash": ">=0.14.0"
  },
  "dependencies": {
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "emdash": "^0.29.0",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EmPlugins/EmPrivacy.git"
  },
  "bugs": {
    "url": "https://github.com/EmPlugins/EmPrivacy/issues"
  },
  "homepage": "https://github.com/EmPlugins/EmPrivacy#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "pnpm": {
    "overrides": {
      "kysely": "0.29.2"
    }
  },
  "scripts": {
    "sync:version": "node scripts/write-version.mjs",
    "verify:exports": "node scripts/verify-exports.mjs",
    "build": "tsdown src/index.ts src/sandbox-entry.ts --format esm --dts --clean",
    "dev": "tsdown src/index.ts src/sandbox-entry.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "audit": "pnpm audit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run",
    "emdash:conformance": "bash scripts/emdash-conformance.sh",
    "release:version": "pnpm changeset version && pnpm run sync:version",
    "release:publish": "pnpm run sync:version && pnpm run typecheck && pnpm run build && pnpm test && pnpm run verify:exports && pnpm run audit && pnpm publish --access public",
    "prepublishOnly": "pnpm run sync:version && pnpm run typecheck && pnpm run build && pnpm test && pnpm run verify:exports && pnpm run audit"
  },
  "engines": {
    "node": ">=20"
  }
}
